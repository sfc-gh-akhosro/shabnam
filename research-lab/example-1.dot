digraph platform {
    rankdir=LR

    // -------------------------------------------------- Sources
    subgraph cluster_sources {
        label = "Sources"

        blobs [shape=record icon="database.svg" caption="Object Store" label="{Blobs | {Tables | Data | Metadata}}"]
        lake  [shape=record icon="cloud.svg" label="{Data Lake | {Batch | Columnar | Vectors}}"]
        vault [shape=record label="{Key Vault | {Issue | Rotate | Revoke | Audit}}"]
    }

    // -------------------------------------------------- Platform Core
    subgraph cluster_platform {
        label = "Platform Core"

        runtime    [shape=record label="Managed Catalog"]
        core       [shape=record icon="cloud.svg" caption="Platform Core" label="{Platform Core | {Security | Governance}}"]
        engine     [shape=record label="{Query Services | {Batch | Stream | Cached}}"]
        context    [shape=record label="{Semantic Context | {Models | Metrics | Search | Functions}}"]
    }

    // -------------------------------------------------- Consumer Services
    subgraph cluster_consumer {
        label = "Consumer Services"

        portal     [shape=record label="{Partner Portal | {Agents | MCP | Assistant}}"]
        runners    [shape=record icon="python.svg" label="{Container Services | {Notebook | Batch | Python | SQL}}"]
        connectors [shape=record label="{Data Exchange | {SDK | Streams | Transforms}}"]
        apps       [shape=record label="{Client Apps | {Dashboards | Serverless | Pipelines | ML Apps}}"]
        bots       [shape=record label="{Assistants | {Chat | Gateway | Console}}"]
        ml         [shape=record icon="python.svg" label="{Machine Learning | {Feature Store | Train | Inference}}"]
    }

    // -------------------------------------------------- Connections
    blobs -> core
    lake -> runtime [dir=both]
    core -> runtime [dir=both xlabel="sync"]
    core -> engine
    core -> context

    engine -> runners
    engine -> ml
    engine -> connectors

    connectors -> apps
    context -> bots
    bots -> portal
    vault -> bots
}
